<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Curiosity.Plugin's real target (see its csproj comment); also means this test
         project needs no Windows Forms and could in principle run cross-platform, even though
         nothing in this repo has actually run `dotnet test` yet (no reachable .NET SDK when this
         was authored — see STATUS.md). -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only references the NL parser types, which have no AutoCAD assembly dependency and so are
         the one part of the plugin actually testable outside a real AutoCAD session. Execution/
         and Ui/ need AcMgd/AcDbMgd and can only be verified by loading into real AutoCAD. -->
    <Compile Include="..\Curiosity.Plugin\NlParser\IntentSchema.cs" />
    <Compile Include="..\Curiosity.Plugin\NlParser\LocalPatternMatcher.cs" />
  </ItemGroup>

</Project>
