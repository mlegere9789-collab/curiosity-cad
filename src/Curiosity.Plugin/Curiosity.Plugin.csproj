<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Originally assumed net48 (true for AutoCAD 2025/2026's managed API), but a real build against
         a real AutoCAD 2027 install proved that wrong: AcMgd/AcDbMgd/AcCoreMgd there are compiled
         against System.Runtime 10.0.0.0-era facades, which net48 can't satisfy (CS1705 assembly
         version errors). AutoCAD 2027 evidently moved its managed API onto a modern .NET runtime.
         net8.0-windows matches that, and also natively supports records/init accessors (no
         IsExternalInit polyfill needed) and, with UseWindowsForms below, System.Windows.Forms. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    AutoCAD's managed API assemblies (AcMgd.dll, AcDbMgd.dll, AcCoreMgd.dll) are NOT published on NuGet.
    They ship inside the AutoCAD install itself. Point AUTOCAD_INSTALL_DIR at the real install
    (see docs/PLUGIN_SETUP.md) via an environment variable or a local, untracked
    Curiosity.Plugin.csproj.user file — do not hardcode a path here, since every dev's AutoCAD
    install directory differs. This project has never been compiled: it was authored outside
    Windows/AutoCAD. Building it for the first time is the explicit next step in STATUS.md.
  -->
  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
