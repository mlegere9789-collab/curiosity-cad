<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Went net48 to net8.0-windows to net10.0-windows, each step corrected by a real build error
         against a real AutoCAD 2027 install. AcMgd/AcDbMgd/AcCoreMgd there are compiled directly
         against System.Runtime 10.0.0.0 (CS1705 confirmed this exactly, twice, first against net48's
         facade then against net8.0's). AutoCAD 2027 has moved its managed API onto .NET 10.
         Note for future edits: a literal double hyphen character anywhere in an XML comment breaks
         MSBuild parsing with error MSB4025, confirmed by a real build. Do not write two consecutive
         hyphen characters inside any csproj comment. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    AutoCAD's managed API assemblies (AcMgd.dll, AcDbMgd.dll, AcCoreMgd.dll) are NOT published on NuGet.
    They ship inside the AutoCAD install itself. Point AUTOCAD_INSTALL_DIR at the real install
    (see docs/PLUGIN_SETUP.md) via an environment variable or a local, untracked
    Curiosity.Plugin.csproj.user file — do not hardcode a path here, since every dev's AutoCAD
    install directory differs. This project has never been compiled: it was authored outside
    Windows/AutoCAD. Building it for the first time is the explicit next step in STATUS.md.
  -->
  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AUTOCAD_INSTALL_DIR)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
